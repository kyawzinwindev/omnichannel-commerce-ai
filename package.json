{
  "name": "omnichannel-commerce-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=apps/server run start:dev",
    "build:server": "npm --workspace=apps/server run build",
    "build": "npm run build --workspaces",
    "prisma:seed": "npm --workspace=apps/server run prisma:seed",
    "dev:admin": "npm --workspace=apps/admin run dev",
    "build:admin": "npm --workspace=apps/admin run build",
    "prisma:migrate": "npm --workspace=apps/server run prisma:migrate"
  }
}
