{
  "name": "omnichannel-commerce-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=apps/server run start:dev",
    "dev:widget": "npm --workspace=apps/widget run dev",
    "build:server": "npm --workspace=apps/server run build",
    "build:widget": "npm --workspace=apps/widget run build",
    "build": "npm run build --workspaces",
    "test:intent": "npm --workspace=apps/server run test:intent",
    "test:vector": "npm --workspace=apps/server run test:vector",
    "test:chat": "npm --workspace=apps/server run test:chat",
    "test:api": "npm --workspace=apps/server run test:api"
  }
}
