generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum SenderType {
  USER
  ASSISTANT
  SYSTEM
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  apiKey        String         @unique @default(uuid()) @map("api_key")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  products      Product[]
  orders        Order[]
  conversations Conversation[]

  @@map("tenants")
}

model Conversation {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  externalUserId String?   @map("external_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([tenantId])
  @@index([externalUserId])
  @@map("conversations")
}

model Message {
  id              String                        @id @default(uuid())
  conversationId  String                        @map("conversation_id")
  senderType      SenderType                    @map("sender_type")
  content         String                        @db.Text
  vectorEmbedding Unsupported("vector(384)")?   @map("vector_embedding")
  metadata        Json?
  createdAt       DateTime                      @default(now()) @map("created_at")
  conversation    Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Product {
  id          String                        @id @default(uuid())
  tenantId    String                        @map("tenant_id")
  name        String
  description String?
  price       Decimal                       @db.Decimal(10, 2)
  category    String?
  inStock     Boolean                       @default(true) @map("in_stock")
  image       String?
  attributes  Json?
  embedding   Unsupported("vector(384)")?

  createdAt   DateTime                      @default(now()) @map("created_at")
  updatedAt   DateTime                      @updatedAt @map("updated_at")
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("products")
}

model Order {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  orderNumber   String            @map("order_number")
  customerEmail String?           @map("customer_email")
  totalAmount   Decimal           @default(0.00) @db.Decimal(10, 2) @map("total_amount")
  status        String            @default("processing")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps         OrderStatusStep[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("orders")
}

model OrderStatusStep {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  title        String
  timestampStr String   @map("timestamp_str")
  status       String   // 'completed' | 'current' | 'pending'
  icon         String?  // 'check' | 'truck' | 'home' | 'package'
  stepIndex    Int      @default(0) @map("step_index")
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_steps")
}
