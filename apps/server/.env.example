PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnichannel_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Groq (exclusive LLM provider)
# Intent: openai/gpt-oss-20b, Response: openai/gpt-oss-120b
GROQ_API_KEY="your_groq_api_key_here"

# Telegram
TELEGRAM_BOT_TOKEN="your_telegram_api_key_here"
# Local dev: set true to use long polling (no public URL needed)
TELEGRAM_USE_POLLING=true
# Production webhook mode (https only). Route: POST /api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=""
# Optional: shared secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""
# Tenant whose catalog the bot serves
TELEGRAM_TENANT_ID="demo-store-01"

# Admin dashboard auth (change in production)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
